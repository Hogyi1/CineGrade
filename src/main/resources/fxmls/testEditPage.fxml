<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: -clr-almostdarkgrey;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/theme.css"/>
    </stylesheets>
    <children>
        <VBox alignment="CENTER" spacing="16.0">
            <children>
                <Label style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: -clr-text-primary;"
                       text="Catalog is opened successfully!"/>
                <Label style="-fx-font-size: 18px; -fx-text-fill: -clr-text-secondary;"
                       text="CineGrade Editor Test View"/>
            </children>
        </VBox>
    </children>
</StackPane>

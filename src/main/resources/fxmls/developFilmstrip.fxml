<?xml version="1.0" encoding="UTF-8"?>
<!-- [AI-GENERATED] -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="filmstripRoot" prefHeight="138.0" minHeight="125.0" maxHeight="150.0"
      styleClass="filmstrip-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Top Filter Bar -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filmstrip-filter-bar">
            <children>
                <!-- Search Field -->
                <TextField fx:id="filmstripSearchField" promptText="Filter by filename..." styleClass="filter-search-field"/>

                <!-- Star Rating Filter (≥ 1 to 5) -->
                <HBox alignment="CENTER" spacing="2.0">
                    <children>
                        <Label styleClass="histogram-exif" text="Rating:"/>
                        <ToggleButton fx:id="star1Btn" mnemonicParsing="false" styleClass="filter-icon-btn" text="★"/>
                        <ToggleButton fx:id="star2Btn" mnemonicParsing="false" styleClass="filter-icon-btn" text="★"/>
                        <ToggleButton fx:id="star3Btn" mnemonicParsing="false" styleClass="filter-icon-btn" text="★"/>
                        <ToggleButton fx:id="star4Btn" mnemonicParsing="false" styleClass="filter-icon-btn" text="★"/>
                        <ToggleButton fx:id="star5Btn" mnemonicParsing="false" styleClass="filter-icon-btn" text="★"/>
                    </children>
                </HBox>

                <!-- Flags: Pick / Reject -->
                <HBox alignment="CENTER" spacing="4.0">
                    <children>
                        <ToggleButton fx:id="flagPickBtn" mnemonicParsing="false" styleClass="filter-icon-btn" text="⚑"/>
                        <ToggleButton fx:id="flagRejectBtn" mnemonicParsing="false" styleClass="filter-icon-btn" text="✕"/>
                    </children>
                </HBox>

                <!-- Color Labels (5 Dots) -->
                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Button fx:id="colorRedBtn" mnemonicParsing="false" style="-fx-background-color: #E02424;" styleClass="filter-color-pill"/>
                        <Button fx:id="colorYellowBtn" mnemonicParsing="false" style="-fx-background-color: #F59E0B;" styleClass="filter-color-pill"/>
                        <Button fx:id="colorGreenBtn" mnemonicParsing="false" style="-fx-background-color: #10B981;" styleClass="filter-color-pill"/>
                        <Button fx:id="colorBlueBtn" mnemonicParsing="false" style="-fx-background-color: #1C7DF0;" styleClass="filter-color-pill"/>
                        <Button fx:id="colorPurpleBtn" mnemonicParsing="false" style="-fx-background-color: #9999FF;" styleClass="filter-color-pill"/>
                    </children>
                </HBox>

                <!-- Tag Filter Menu -->
                <MenuButton fx:id="filterTagMenu" mnemonicParsing="false" styleClass="hud-btn" text="Tags ( 0 )"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Photo Counter Label -->
                <Label fx:id="filmstripCountLabel" styleClass="hud-meta" text="0 photos / 0 selected"/>

                <!-- Filmstrip Zoom Slider -->
                <HBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label styleClass="histogram-exif" text="Zoom:"/>
                        <Slider fx:id="filmstripZoomSlider" max="1.5" min="0.6" prefWidth="75.0" styleClass="grade-slider" value="1.0"/>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Horizontal Filmstrip Cards Carousel -->
        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="filmstrip-scroll" VBox.vgrow="ALWAYS">
            <content>
                <HBox fx:id="filmstripCardsContainer" alignment="CENTER_LEFT" spacing="10.0" styleClass="filmstrip-cards-box">
                    <children>
                        <!-- Dynamic photo cards are injected here by controller -->
                    </children>
                </HBox>
            </content>
        </ScrollPane>
    </children>
</VBox>

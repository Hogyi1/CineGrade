<?xml version="1.0" encoding="UTF-8"?>
<!-- [AI-GENERATED] -->

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<BorderPane maxHeight="58.0" minHeight="56.0" prefHeight="58.0" prefWidth="1280.0"
            styleClass="navigation-bar, theme-dark"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hu.elte.ik.thesis.cinegrade.javafx.ui.editing.NavigationController">
    <stylesheets>
        <URL value="@../css/theme.css"/>
        <URL value="@../css/navigationPanel.css"/>
    </stylesheets>

    <!-- Left: Brand Logo & Normal Catalog Name Label -->
    <left>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="brand-box" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="28.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/icons/cine-logo.png"/>
                    </image>
                </ImageView>

                <Region fx:id="brandSeparator" styleClass="brand-separator"/>

                <!-- Normal sleek text label without button/box wrapper -->
                <Label fx:id="catalogTitleLabel" styleClass="catalog-title" text="Untitled Catalog"/>
            </children>
        </HBox>
    </left>

    <!-- Center: Slim Floating Pill Navigation Capsule -->
    <center>
        <HBox alignment="CENTER" BorderPane.alignment="CENTER">
            <children>
                <StackPane fx:id="navPillContainer" styleClass="nav-pill-container">
                    <children>
                        <!-- Dynamic Floating Selection Bubble -->
                        <Region fx:id="selectionBubble" mouseTransparent="true" styleClass="selection-bubble"/>

                        <!-- Navigation Tabs ("Buttons") -->
                        <HBox fx:id="tabsContainer" alignment="CENTER" spacing="2.0" styleClass="nav-items-box">
                            <children>
                                <Label fx:id="importTab" styleClass="nav-item, nav-item-active" text="Import"/>
                                <Label fx:id="developTab" styleClass="nav-item, nav-item-inactive" text="Development"/>
                                <Label fx:id="exportTab" styleClass="nav-item, nav-item-inactive" text="Export"/>
                            </children>
                        </HBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </center>

    <!-- Right: Back to Projects Button & Profile Avatar -->
    <right>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="backToProjectsBtn" mnemonicParsing="false" styleClass="nav-action-btn" text="Projects"/>
                <Button fx:id="userProfileBtn" mnemonicParsing="false" styleClass="profile-avatar-btn">
                    <graphic>
                        <Circle fill="#D9D9D9" radius="15.0"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </right>
</BorderPane>

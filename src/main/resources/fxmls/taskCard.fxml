<?xml version="1.0" encoding="UTF-8"?>
<!-- [AI-GENERATED] -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="taskCardRoot" prefWidth="390.0" styleClass="task-card-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Header: Task Title & Cancel Button -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Label fx:id="taskTitleLabel" styleClass="task-card-title" text="Processing Photo Batch..."/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="taskCancelBtn" mnemonicParsing="false" styleClass="task-card-cancel-btn" text="✕"/>
            </children>
        </HBox>

        <!-- Progress Bar & Percentage -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <ProgressBar fx:id="taskProgressBar" prefWidth="310.0" progress="0.45" styleClass="task-progress-bar" HBox.hgrow="ALWAYS"/>
                <Label fx:id="taskPercentageLabel" styleClass="histogram-exif" text="45%"/>
            </children>
        </HBox>

        <!-- Status Message -->
        <Label fx:id="taskMessageLabel" styleClass="task-card-message" text="Exporting frame 14 of 32 (1024x1024 tiles)..."/>
    </children>
</VBox>

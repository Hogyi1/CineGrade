<?xml version="1.0" encoding="UTF-8"?>
<!-- [AI-GENERATED] -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="viewportRoot" prefHeight="650.0" prefWidth="750.0"
           styleClass="viewport-root"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Center Image View Holder -->
        <StackPane fx:id="viewportImageContainer" styleClass="viewport-stack" StackPane.alignment="CENTER">
            <children>
                <ImageView fx:id="viewportImageView" pickOnBounds="true" preserveRatio="true" styleClass="viewport-image-view"/>
            </children>
        </StackPane>

        <!-- Top Floating HUD Bar -->
        <HBox alignment="CENTER_LEFT" maxHeight="38.0" maxWidth="680.0" prefHeight="38.0" styleClass="viewport-hud"
              StackPane.alignment="TOP_CENTER">
            <StackPane.margin>
                <Insets top="14.0"/>
            </StackPane.margin>
            <children>
                <Label fx:id="photoNameLabel" styleClass="hud-filename" text="No Photo Selected"/>
                <Label fx:id="photoMetaLabel" styleClass="hud-meta" text="— RAW 16-bit"/>

                <Region HBox.hgrow="ALWAYS"/>

                <ToggleButton fx:id="splitViewToggle" mnemonicParsing="false" styleClass="hud-btn" text="Before / After"/>
                <Button fx:id="zoomFitBtn" mnemonicParsing="false" styleClass="hud-btn" text="Fit"/>
                <Button fx:id="zoom100Btn" mnemonicParsing="false" styleClass="hud-btn" text="100%"/>
                <Slider fx:id="zoomSlider" max="4.0" min="0.1" prefWidth="90.0" styleClass="grade-slider" value="1.0"/>
            </children>
        </HBox>
    </children>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>
<!-- [AI-GENERATED] -->

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="taskManagerRoot" prefHeight="420.0" prefWidth="440.0"
      styleClass="task-manager-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/theme.css"/>
        <URL value="@../css/taskManager.css"/>
    </stylesheets>

    <!-- Header -->
    <children>
        <HBox alignment="CENTER_LEFT" styleClass="task-manager-header">
            <children>
                <Label styleClass="task-manager-title" text="Background Tasks"/>
                <Label fx:id="activeTasksBadge" styleClass="task-badge-count" text="0 active"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="taskManagerCloseBtn" mnemonicParsing="false" styleClass="task-card-cancel-btn" text="✕"/>
            </children>
        </HBox>

        <!-- Tasks Content Area -->
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <!-- Empty Placeholder -->
                <VBox fx:id="emptyTasksContainer" alignment="CENTER" styleClass="empty-tasks-placeholder">
                    <children>
                        <Label styleClass="empty-tasks-label" text="No active background tasks running."/>
                    </children>
                </VBox>

                <!-- Scrollable Task Cards List -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="task-scroll-pane">
                    <content>
                        <VBox fx:id="tasksCardsContainer" spacing="10.0" styleClass="task-cards-container">
                            <!-- Injected dynamically -->
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </children>
</VBox>
